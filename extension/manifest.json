{
  "manifest_version": 3,
  "name": "Draft Helper — ESPN Sync",
  "version": "0.1.0",
  "description": "One click syncs your live ESPN draft to the Draft Helper. Reads only a per-draft token; never your ESPN password.",
  "permissions": ["cookies", "tabs"],
  "host_permissions": [
    "https://*.espn.com/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sync my draft"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
